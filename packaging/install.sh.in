#!/usr/bin/env bash
#
# Installs Koe @VERSION@ (fully local voice dictation) on this Mac:
#
#   curl -fsSL https://github.com/IbrahimKhanGH/Koe/releases/latest/download/install.sh | bash
#
# Downloads the app from this release over HTTPS, checks its SHA-256 against the
# one written below when the release was made, and puts it in /Applications (or
# ~/Applications if this account can't write there). Run it again to update.
#
# A download made in Terminal isn't marked "from the internet", so macOS doesn't
# show its unidentified-developer warning; this script is what vouches for the
# app instead, by its fingerprint.
#
# Generated by scripts/release.sh; edit packaging/install.sh.in, not this file.

# Everything runs inside main, called on the last line, so a download cut off
# halfway can never run half a script.
main() {
  set -euo pipefail

  local version="@VERSION@"
  local sha256="@SHA256@"
  local url="https://github.com/IbrahimKhanGH/Koe/releases/download/v${version}/Koe-${version}.zip"

  say() { printf '\033[1m%s\033[0m\n' "$*"; }
  fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

  [ "$(uname -s)" = "Darwin" ] || fail "Koe is a Mac app."
  [ "$(uname -m)" = "arm64" ] || fail "Koe needs an Apple Silicon Mac (M1 or newer)."
  local major
  major="$(sw_vers -productVersion | cut -d. -f1)"
  [ "$major" -ge 14 ] || fail "Koe needs macOS 14 (Sonoma) or newer."

  # Global, not local: the EXIT trap runs after main has returned.
  KOE_TMP="$(mktemp -d)"
  trap 'rm -rf "$KOE_TMP"' EXIT
  local tmp="$KOE_TMP"

  say "Downloading Koe ${version}…"
  curl -fL --proto '=https' --tlsv1.2 --progress-bar -o "$tmp/Koe.zip" "$url"

  say "Checking its fingerprint…"
  local got
  got="$(shasum -a 256 "$tmp/Koe.zip" | cut -d' ' -f1)"
  [ "$got" = "$sha256" ] || fail "The download doesn't match this release's fingerprint. Nothing was installed."

  /usr/bin/ditto -x -k "$tmp/Koe.zip" "$tmp/unzipped"
  [ -d "$tmp/unzipped/Koe.app" ] || fail "The download didn't contain Koe.app. Nothing was installed."

  local dest="/Applications"
  if [ ! -w "$dest" ]; then
    dest="$HOME/Applications"
    mkdir -p "$dest"
  fi

  # Quit a running copy so it can be replaced.
  if pgrep -xq koe-tauri; then
    say "Quitting the running Koe…"
    osascript -e 'quit app "Koe"' >/dev/null 2>&1 || true
    sleep 2
    pkill -x koe-tauri 2>/dev/null || true
    pkill -x koe-llm-worker 2>/dev/null || true
  fi

  rm -rf "$dest/Koe.app"
  mv "$tmp/unzipped/Koe.app" "$dest/Koe.app"

  say "Installed Koe ${version} in ${dest}. Opening it…"
  open "$dest/Koe.app"
  echo
  echo "Next, in Koe:"
  echo "  1. Grant Accessibility and Microphone on the setup screen."
  echo "  2. Models → Download (Balanced, or Max on a Mac with 32 GB+ of memory) → Restart now."
  echo "  3. Hold fn and talk, or press ⌘⇧Space to start and stop."
  echo
  echo "Updating later? Run the same command again. macOS will ask for the permissions again after an update."
}

main "$@"
